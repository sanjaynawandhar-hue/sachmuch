{
  "expo": {
    "name": "Sachmuch",
    "slug": "sachmuch",
    "scheme": "sachmuch",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.sachmuch.app",
      "adaptiveIcon": {
        "backgroundColor": "#E9E4F0"
      }
    },
    "ios": {
      "bundleIdentifier": "com.sachmuch.app",
      "supportsTablet": true
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ]
    ]
  }
}
