# Copy this file to `.env` and fill in the values. `.env` is gitignored.
#
#   cp .env.example .env
#
# Nothing here is needed to run the tests or the web app. DATABASE_URL is needed
# to store facts; the API keys are needed only by the Tier 2 connectors.

# ── Required to store anything ────────────────────────────────────────────────
# Supabase -> Connect -> Direct Connection string -> Session pooler -> URI.
#
# Use the SESSION POOLER, and use it everywhere. Not because direct is broken —
# direct connections are IPv6-only, and a dev machine on an Indian ISP usually
# does have IPv6 these days. The reason is CI: GitHub Actions runners are
# IPv4-only, so a direct-connection URL works locally and then fails every night
# in the ingestion job, where nobody is watching. One URL that works in both
# places is worth more than a marginally shorter network path.
#
# Not the TRANSACTION pooler (port 6543) either — it cannot run the schema
# statements the migrations need.
#
# Replace [YOUR-PASSWORD] (brackets included) with the database password.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# ── Required before the crawler runs against Wikimedia ────────────────────────
# Wikimedia requires a descriptive User-Agent with a REAL, monitored contact on
# every request, and blocks generic ones. Put a working address here.
SACHMUCH_USER_AGENT="SachmuchBot/0.1 (https://sachmuch.com; sanjay.nawandhar@gmail.com) node-fetch"

# ── Tier 2 connectors. Free tiers only; leave blank to skip that source. ───────
# themoviedb.org -> Settings -> API -> API Read Access Token (the long JWT,
# not the short v3 key). Sent as `Authorization: Bearer <token>`.
# Feeds Bollywood, Hollywood, Actors and Television.
TMDB_READ_TOKEN=
# data.gov.in -> Sign up -> My Account -> API key. Feeds the India categories.
DATA_GOV_IN_KEY=
# api.nasa.gov. Optional: DEMO_KEY works but throttles hard.
NASA_API_KEY=

# ── Optional ──────────────────────────────────────────────────────────────────
# How long one ingestion run spends claiming jobs. The Actions job times out at 60.
INGEST_BUDGET_MINUTES=45
